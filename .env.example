# ==============================================================================
# Sentinel AI - Production-Ready Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to create a '.env' file in the project root:
#    cp .env.example .env
# 2. Fill in your environment-specific credentials and secrets below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Settings
# ------------------------------------------------------------------------------
# Deployment environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Enable or disable debug mode (True / False)
DEBUG=True

# Application identity & versioning
APP_NAME="Sentinel AI"
APP_VERSION=1.0.0
API_V1_STR=/api/v1

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","*"]


# ------------------------------------------------------------------------------
# 2. PostgreSQL Relational Database Configuration
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# Optional: Direct connection URL override (Uncomment if using external provider like Supabase/Neon)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinel_db


# ------------------------------------------------------------------------------
# 3. Neo4j Knowledge Graph Configuration
# ------------------------------------------------------------------------------
# Neo4j Graph DB connection parameters
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password


# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (Replace with a strong secret in production)
SECRET_KEY=YOUR_SUPER_SECRET_JWT_KEY_CHANGE_IN_PRODUCTION

# JWT signature algorithm
ALGORITHM=HS256

# JWT token expiration time in minutes (10080 minutes = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080


# ------------------------------------------------------------------------------
# 5. Google Gemini AI Integration
# ------------------------------------------------------------------------------
# Google Gemini API key for AI agent orchestration & RAG capabilities
GEMINI_API_KEY=your_gemini_api_key_here

# Target Gemini model version
GEMINI_MODEL=gemini-2.0-flash

# Default temperature for LLM generation (0.0 to 1.0)
GEMINI_TEMPERATURE=0.2


# ------------------------------------------------------------------------------
# 6. Machine Learning Model Directory
# ------------------------------------------------------------------------------
# Relative path to directory containing trained ML models
ML_MODEL_DIR=ml/models
